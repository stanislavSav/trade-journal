#!/bin/sh
# Commits in this repo have one author: the owner. No AI co-author trailers or tool mentions.
# Enable once per clone: git config core.hooksPath .githooks
if grep -v '^#' "$1" | grep -q -i -E 'co-authored-by|claude|anthropic'; then
  echo "commit-msg: remove Co-Authored-By trailers and Claude/Anthropic mentions from the message." >&2
  exit 1
fi
